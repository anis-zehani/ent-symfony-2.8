    <SCRIPT type="text/javascript">
        var idSuppression = 0;
    </SCRIPT>

</head>

<body class="text-center" style="background-color: #ffffff;font-family: 'Roboto';font-weight: 200;">
<nav class="navbar navbar-expand-lg navbar-light fixed-top navbar-inverse" style="height:7ch;background-color: #ed494c;font-size:15px;font-weight: 300;">
	
	<!-- Exit si session expirée-->
    {% set session = render(controller('PronoteBundle:Professeurs:session',{ 'max': 0 })) %}
    {% if session |length < 3 %}
        <script>
        	alert("\nBonjour\n\nVotre session a expiré, merci de vous identifier de nouveau\n\nÀ tout de suite");
        	window.location.href = "../exitProfesseurSession/";
        </script>
    {% endif %}
	<!-- FIN Exit si session expirée-->
   
   
    <a class="navbar-brand" href="{{app.request.basePath}}/professeur/home/" >
        <img src="{{app.request.basePath}}/{{logoEcole}}" alt="Acceuil" style="padding-top:0px;border:0;cursor: pointer;width:110px;background-color: #ed494c;">
    </a>


  <button class="navbar-toggler" style="background-color: #e9ebee" type="button" data-toggle="collapse" data-target="#navbarText" aria-controls="navbarText" aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
  </button>

  <div class="collapse navbar-collapse" id="navbarText" style="background-color: #ed494c;">  
        <ul class="navbar-nav mr-auto">
        
        </ul>
        <span class="navbar-text" style="color: #ffffff;">
            Professeur : {{ app.session.get('nomProfesseur') }} - {{ "now"|date("d/m/Y", "Europe/Paris") }} <a href="{{app.request.basePath}}/professeur/exitProfesseurSession/"><img src={{ asset('bootstrap/img/exit.png') }} width="25" height="25"></a>
        </span>
  </div>
</nav>