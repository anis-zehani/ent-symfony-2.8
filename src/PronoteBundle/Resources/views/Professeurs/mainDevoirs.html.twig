<!-- Clique sur l'icône Modifier (dans le tableau Devoirs)-->
<SCRIPT>
    function modifierDevoir(idDevoir, detailsDevoir, donnePour ,idMatiereDevoir , idClasseDevoir)
    {

        document.getElementById("idDevoir").value = idDevoir;
        document.getElementById("detailsDevoir").value = detailsDevoir;
        document.getElementById("donnePour").value = donnePour;
        document.getElementById("idMatiereDevoir").value = idMatiereDevoir;
        document.getElementById("idClasseDevoir").value = idClasseDevoir;

        document.getElementById("btnAjouter").value = 'Modifier un devoir';
        var formulaire = document.getElementById('formDevoirs');
        formulaire.setAttribute("action", "{{app.request.basePath}}/professeur/updateDevoir/");

    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Devoirs)-->
<SCRIPT>
    function resetDevoir()
    {

        document.getElementById("detailsDevoir").value = '';
        document.getElementById("donnePour").value = '';
        document.getElementById("idMatiereDevoir").value = '';
        document.getElementById("idClasseDevoir").value = '';

        document.getElementById("btnAjouter").value = 'Ajouter un devoir';
        var formulaire = document.getElementById('formDevoirs');
        formulaire.setAttribute("action", "{{app.request.basePath}}/professeur/addDevoir/");
    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale sur Devoirs-->
<SCRIPT type="text/javascript">
    $('#ModaleDevoir').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');
        idSuppression=0;
    })
</SCRIPT>

{%  include 'PronoteBundle:Professeurs:footer.html.twig' %}