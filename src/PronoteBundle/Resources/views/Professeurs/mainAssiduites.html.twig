{%  include 'PronoteBundle:Professeurs:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >
  
    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification Assiduite-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="{{app.request.basePath}}/professeur/addAssiduite/" method="post" name="formAssiduites" id="formAssiduites">

                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Gestion de l'assiduité</label>
                </div>

                <div class="form-group" onchange="resetListeEleves('-1');">
                    <label for="inputClasseAssiduite"><b>Classe concernée (*)</b></label>

                    <select id="idClasseAssiduite" name="idClasseAssiduite" style="border-radius: 10px;width: 100%" required>
                        <option value="0" id="labeClasse">Vous devez choisir une classe</option>
                        {% for key in allClasses %}
                            <option value="{{ key.idClasse }}">{{ key.nomClasse|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group" id="listeEleves">
                    <label for="inputEleve"><b>Élève concerné (*)</b></label>


                    <select id="idListeEleve" name="idListeEleve" style="border-radius: 10px;width: 100%" required >
                        <option value="">Aucune classe n'a été choisie</option>
                        {% for key in allAssiduites %}
                        	 <!-- <option value="{{ key.idEleve }}">{{ key.prenomEleve|capitalize }} {{ key.nomEleve|capitalize }}</option>-->
                        {% endfor %}
                    </select>
                </div>


                <div class="form-group">
                    <label for="inputIdFautes"><b>Type faute (*)</b></label>

                    <select id="inputFautes" name="inputFautes" style="border-radius: 10px;width: 100%" required>
                        <option value="">Vous devez choisir le type de la faute</option>
                        {% for key in allFautes %}
                            <option value="{{ key.idFaute }}">{{ key.typeFaute|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label for="inputDetailsAssiduite"><b>Détails de la faute</b></label>
                    <textarea class="form-control" rows="3" id="detailsAssiduite" name="detailsAssiduite" ></textarea>
                </div>
                
                <div class="form-group">
                    <label for="inputDateFaute"><b>Date faute</b></label>
                    <input type="date" class="form-control" id="dateFaute" name="dateFaute">
                </div>

                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter une assiduité" style="background-color: #189d8c;border: none;" />
                </div>

                <input type="hidden" id="idAssiduite" name="idAssiduite" value="idAssiduite"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnReset" onclick="resetAssiduite();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;" />

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>
				
                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <br><h6 style="color: #e3352c;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}

            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;" >

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th width="13%">Date faute</th>
                    <th>Détails faute</th>
                    <th width="13%">Type faute</th>
                    <th width="15%">Élève</th>
                    <th>Classe</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allAssiduites %}
                    <tr>
                        <td style="text-align:center;background-color: #FFFFFF;font-size: 13px;">
                            <a href="#" onclick="idSuppression={{key.idAssiduite}}; document.getElementById('idAssiduiteDelete').setAttribute('value',idSuppression); $('#ModaleAssiduite').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td style=";background-color: #FFFFFF;font-size: 13px;">{{ key.dateFaute }}</td>
                        <td style=";background-color: #FFFFFF;font-size: 13px;">{{ key.detailsFaute|capitalize }}</td>
                        <td style=";background-color: #FFFFFF;font-size: 13px;">{{ key.typeFaute|capitalize }}</td>
                        <td style=";background-color: #FFFFFF;font-size: 13px;">{{ key.prenomEleve|capitalize }} {{ key.nomEleve|capitalize }}</td>
                        <td style=";background-color: #FFFFFF;font-size: 13px;">{{ key.nomClasseEleve|capitalize }}</td>
                        <td style="text-align:center;background-color: #FFFFFF;font-size: 13px;">
                        	{% if key.idClasseEleve > 0 %}
                            <a href="#" id="btnModifier" onclick="modifierAssiduite('{{ key.idAssiduite }}','{{ key.detailsFaute |replace({"'": "\\'",'\r\n': '\\r\\n', '\n': '\\n', '\r': '\\r'})}}','{{ key.dateFaute |date("Y-m-d")}}','{{ key.idTypeFaute }}','{{ key.idClasseEleve }}','{{ key.idEleve }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a>
                        	{% else %}
                        	<img src="{{ asset('./bootstrap/img/update-gris.jpg') }}" width="20" height="20" >
                        	{% endif %}
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleAssiduite" tabindex="-1" role="dialog" aria-labelledby="exampleModaleAssiduiteTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="{{app.request.basePath}}/professeur/deleteAssiduite/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer une assiduité</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Attention, vous êtes sur le point de supprimer cette assiduité.
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idAssiduiteDelete" name="idAssiduiteDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Valider</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Assiduites)-->
<SCRIPT>
    function modifierAssiduite(idAssiduite, detailsAssiduite, dateFaute , idTypeFaute , idClasseEleve, idEleve)
    {
    	
        document.getElementById("idAssiduite").value = idAssiduite;
        document.getElementById("detailsAssiduite").value = detailsAssiduite;
        document.getElementById("dateFaute").value = dateFaute;
        document.getElementById("inputFautes").value = idTypeFaute;
        document.getElementById("idClasseAssiduite").value = idClasseEleve;

        //Important : passage de ID élève afin de faire appel Ajax en prenant en compte le boutton 'Modifier'
        resetListeEleves(idEleve);

        document.getElementById("btnAjouter").value = 'Modifier une assiduité';
        var formulaire = document.getElementById('formAssiduites');
        formulaire.setAttribute("action", "{{app.request.basePath}}/professeur/updateAssiduite/");
        
    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Assiduites)-->
<SCRIPT>
    function resetAssiduite()
    {
    	

        document.getElementById("detailsAssiduite").value = '';
        document.getElementById("dateFaute").value = '';
        document.getElementById("inputFautes").value = '';
        document.getElementById("idClasseAssiduite").value = '';
        //On vide la liste des élèves
        document.getElementById("idListeEleve").options.length = 0;

      
        document.getElementById("btnAjouter").value = 'Ajouter une assiduite';
        var formulaire = document.getElementById('formAssiduites');
        formulaire.setAttribute("action", "{{app.request.basePath}}/professeur/addAssiduite/");
      
    }
</SCRIPT>

<!-- OnChange Liste des classes-->
<SCRIPT>
    function resetListeEleves(idEleve)
    {
    	
        var idClasse = document.getElementById("idClasseAssiduite").value;

        $.ajax({
            url : '{{app.request.basePath}}/professeur/updateListeEleves/'+idClasse,
            type : 'GET',
            dataType : 'html',
            success : function(data, statut){

                var json = $.parseJSON(data);
                //console.log(json);

                var oOption,
                    oSelect = document.getElementById("idListeEleve"),
                    i, 
                    nb = json.length;

                // vide le select
                oSelect.options.length = 0;
                // désactive si aucune option disponible
                oSelect.disabled = nb ? false : true;
                oSelect.add( new Option( 'Cette classe ne contient aucun élève', ''));
                // focus sur le select
                oSelect.focus();

             	// ajoute 1st option
                if(nb && idEleve == '-1')
                {
                    oSelect.options.length = 0;
                    oSelect.add( new Option( 'Merci de préciser un élève', ''));
                    oSelect.focus();
                }

             	//Trouver le élève sélectionné par le boutton 'Modifier' et le mettre dans la liste déroulante
                if(idEleve != '-1')
                {
                	console.log(idEleve);
                	console.log(json);
                	oSelect.options.length = 0;
                	
                	for (var j=0;j<json.length;++j)
                    {
                        if(json[j].idEnfant == idEleve)
                            {
                        	oSelect.add( new Option(json[j].prenomEnfant.charAt(0).toUpperCase()+json[j].prenomEnfant.slice(1)+' '+json[j].nomEnfant.charAt(0).toUpperCase()+json[j].nomEnfant.slice(1), json[j].idEnfant));
                            oSelect.focus();
                            }
                    }

                }

				//Ajouter tous les autres élèves juste aprés celui qui a été sélectionné via le boutton 'Modifier'
                for (var i=0;i<json.length;++i)
                {
                	if(json[i].idEnfant != idEleve)
                    	{
                        oOption = new Option(json[i].prenomEnfant.charAt(0).toUpperCase()+json[i].prenomEnfant.slice(1)+' '+json[i].nomEnfant.charAt(0).toUpperCase()+json[i].nomEnfant.slice(1), json[i].idEnfant);
                        oSelect.add( oOption);
                    	}
                }

                // si une seule option on la sélectionne
                oSelect.selectedIndex = nb === 1 ? 1 : 0;
                // on retourne la valeur pour le select suivant
                return oSelect.value;
            },

            error : function(resultat, statut, erreur){
                console.log(statut);
                console.log(erreur);
                console.log(resultat);
                
            }
        });

    }
</SCRIPT>


<!-- Code qui s'exécute quand j'ouvre la Modale sur Assiduites-->
<SCRIPT type="text/javascript">
    $('#ModaleAssiduite').on('shown.bs.modal', function () {
        
        $('#myInput').trigger('focus');
        idSuppression=0;
       
    })
</SCRIPT>

{%  include 'PronoteBundle:Professeurs:footer.html.twig' %}