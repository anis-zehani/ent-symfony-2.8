{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >

    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification MenuCantine-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addMenuCantine/" method="post" name="formMenuCantine" id="formMenuCantine" enctype="multipart/form-data">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Menu de la cantine</label>
                </div>

                <div class="form-group">
                    <label for="inputClasseMenuCantine"><b>Classe concernée (*)</b></label>

                    <select id="classeMenuCantine" name="classeMenuCantine" style="border-radius: 10px;width: 100%" required>
                        <option value="">Vous devez choisir une classe</option>
                        {% for key in allClasses %}
                            <option value="{{ key.idClasse }}">{{ key.nomClasse|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group">
                    <label for="inputDescriptionMenuCantine"><b>Description du menu (*)</b></label>
                    <textarea class="form-control" rows="3" id="descriptionMenuCantine" name="descriptionMenuCantine" required></textarea>
                </div>




                <!-- /////////////////////////////////////////////////////////////////////////////////////////////////-->
                <div class="form-group">
                    <label for="inputPathMenuCantine" id="inputPathMenuCantine"><b>Choisir le menu (*) (taille < 8 Mo)</b></label>
                    <input class="form-control" type="file" name="fileMenuCantine" id="fileMenuCantine" required>
                </div>
                <!-- /////////////////////////////////////////////////////////////////////////////////////////////////-->


                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Envoyer le menu de la cantine" style="background-color: #189d8c;border: none;"/>
                </div>

                <input type="hidden" id="idMenuCantine" name="idMenuCantine" value="idMenuCantine"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetMenuCantine();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>

                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <br><h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">
            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                	<th width="10%">Supprimer</th>
                    <th>Description</th>
                    <th>Classe</th>
                    <th>Prévisualiser le Menu</th>
                    <th>Responsable</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allMenuCantine %}
                    <tr>
                    	<td style="text-align:center;background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.idMenuCantine}}; document.getElementById('idMenuCantineDelete').setAttribute('value',idSuppression); $('#ModaleMenuCantine').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td>{{ key.descriptionMenuCantine|capitalize }}</td>
                        <td>{{ key.nomclasseMenuCantine|capitalize }}</td>
                        <td style="-padding: .15rem; vertical-align: center;background-color: #FFFFFF;text-align: center;"><a href="{{app.request.basePath}}/{{key.fileMenuCantine}}">Afficher</a></td>
                        <td>{{ key.nomProfesseur|capitalize }}</td>
                        <td style="text-align:center;background-color: #FFFFFF;font-size: 13px;">
                            <a href="#" id="btnModifier" onclick="modifierMenuCantine('{{ key.idMenuCantine }}','{{ key.descriptionMenuCantine |replace({"'": "\\'",'\r\n': '\\r\\n', '\n': '\\n', '\r': '\\r'})}}','{{ key.classeMenuCantine }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleMenuCantine" tabindex="-1" role="dialog" aria-labelledby="exampleModaleMenuCantineTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteMenuCantine/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer un menu de la cantine</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="text-align:left;">
                                Attention, vous êtes sur le point de supprimer ce Menu.
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idMenuCantineDelete" name="idMenuCantineDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Valider</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Menu cantine)-->
<SCRIPT>
    function modifierMenuCantine(idMenuCantine, descriptionMenuCantine, classeMenuCantine)
    {
        document.getElementById("idMenuCantine").value = idMenuCantine;
        document.getElementById("descriptionMenuCantine").value = descriptionMenuCantine;
        document.getElementById("classeMenuCantine").value = classeMenuCantine;

        document.getElementById("inputPathMenuCantine").innerHTML = "Choisir le menu (taille < 8 Mo)";
        document.getElementById("fileMenuCantine").disabled = true;

        document.getElementById("btnAjouter").value = 'Modifier le menu de la cantine';
        var formulaire = document.getElementById('formMenuCantine');
        formulaire.setAttribute("action", "../updateMenuCantine/");
    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Menu cantine)-->
<SCRIPT>
    function resetMenuCantine()
    {

        document.getElementById("descriptionMenuCantine").value = '';
        document.getElementById("classeMenuCantine").value = '';

        document.getElementById("inputPathMenuCantine").innerHTML = "Choisir le menu (*) (taille < 8 Mo)";
        document.getElementById("fileMenuCantine").disabled = false;

        document.getElementById("btnAjouter").value = 'Envoyer le menu de la cantine';
        var formulaire = document.getElementById('formMenuCantine');
        formulaire.setAttribute("action", "../addMenuCantine/");
    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale sur Menu cantine-->
<SCRIPT type="text/javascript">
    $('#ModaleMenuCantine').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');
        idSuppression=0;
    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
<SCRIPT type="text/javascript">
    $(document).ready(function() {
        $('#my_table').DataTable({
            "fixedColumns": true,
            "autoWidth": true,
            "scrollX": true,
            "scrollY": true,
            "language": {
                "sProcessing": "Traitement en cours ...",
                "sLengthMenu": "Afficher _MENU_ lignes",
                "sZeroRecords": "Aucun résultat trouvé",
                "sEmptyTable": "Aucune donnée disponible",
                "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
                "sInfoEmpty": "Aucune ligne affichée",
                "sInfoFiltered": "(Filtrer un maximum de _MAX_)",
                "sInfoPostFix": "",
                "sSearch": "Chercher :",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Chargement...",
                "oPaginate": {
                    "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
                },
                "oAria": {
                    "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
                }

            }
        });
    } );
</SCRIPT>

{%  include 'PronoteBundle:Admin:footer.html.twig' %}