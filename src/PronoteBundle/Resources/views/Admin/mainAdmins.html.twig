{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >

    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification Admin-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addAdmin/" method="post" name="formAdmins" id="formAdmins">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Gestion des administrateurs</label>
                </div>
                <div class="form-group">
                    <label for="login"><b>Identifiant (*)</b></label>
                    <input type="text" class="form-control" id="loginAdmin" name="loginAdmin" required>
                </div>
                <div class="form-group">
                    <label for="password"><b>Mot de passe (*)</b></label>
                    <input type="text" class="form-control" id="passwordAdmin" name="passwordAdmin" required>
                </div>

                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter un administrateur" style="background-color: #189d8c;border: none;" />
                </div>

                <input type="hidden" id="idAdmin" name="idAdmin" value="idAdmin"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetAdmin();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>

                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <br><h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th>Identifiant</th>
                    <th>Mot de passe</th>
                    <th>Profil</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allAdmins %}
                    <tr>
                        <td style="text-align:center;background-color: #FFFFFF;font-size: 13px;">
                            <a href="#" onclick="idSuppression={{key.idAdmin}};document.getElementById('idAdminDelete').setAttribute('value',idSuppression); $('#ModaleAdmin').modal(); "><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td style="background-color: #FFFFFF;font-size: 13px;">{{ key.loginAdmin }}</td>
                        <td style="background-color: #FFFFFF;font-size: 13px;">{{ key.passwordAdmin }}</td>
                        <td style="background-color: #FFFFFF;font-size: 13px;">{{ key.profil |upper}}</td>
                        <td style="text-align:center;background-color: #FFFFFF;font-size: 13px;"><a href="#" id="btnModifier" onclick="modifierAdmin('{{ key.idAdmin }}','{{ key.loginAdmin }}','{{ key.passwordAdmin }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleAdmin" tabindex="-1" role="dialog" aria-labelledby="exampleModaleAdminTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteAdmin/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer un administrateur</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body">
                                Attention, vous êtes sur le point de supprimer cet administrateur.
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idAdminDelete" name="idAdminDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Valider</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Admin)-->
<SCRIPT>
    function modifierAdmin(idAdmin,loginAdmin,passwordAdmin)
    {
        document.getElementById("idAdmin").value = idAdmin;
        document.getElementById("loginAdmin").value = loginAdmin;
        document.getElementById("passwordAdmin").value = passwordAdmin;

        document.getElementById("btnAjouter").value = 'Modifier un administrateur';
        var formulaire = document.getElementById('formAdmins');
        formulaire.setAttribute("action", "../updateAdmin/");
    }
</SCRIPT>

<!-- Clique sur le bouton Reset(dans le formulaire Admin)-->
<SCRIPT>
    function resetAdmin()
    {
        document.getElementById("loginAdmin").value = '';
        document.getElementById("passwordAdmin").value = '';

        document.getElementById("btnAjouter").value = 'Ajouter un administrateur';
        var formulaire = document.getElementById('formAdmins');
        formulaire.setAttribute("action", "../addAdmin/");

    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale sur Admin-->
<SCRIPT type="text/javascript">
    $('#ModaleAdmin').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');
        idSuppression=0;
    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
<SCRIPT type="text/javascript">
    $(document).ready(function() {
        $('#my_table').DataTable({
            "fixedColumns": true,
            "autoWidth": true,
            "scrollX": true,
            "scrollY": true,
            "language": {
                "sProcessing": "Traitement en cours ...",
                "sLengthMenu": "Afficher _MENU_ lignes",
                "sZeroRecords": "Aucun résultat trouvé",
                "sEmptyTable": "Aucune donnée disponible",
                "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
                "sInfoEmpty": "Aucune ligne affichée",
                "sInfoFiltered": "(Filtrer un maximum de _MAX_)",
                "sInfoPostFix": "",
                "sSearch": "Chercher :",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Chargement...",
                "oPaginate": {
                    "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
                },
                "oAria": {
                    "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
                }

            }
        });
    } );
</SCRIPT>

