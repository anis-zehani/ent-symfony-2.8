{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >
	
    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification Parent-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addParent/" method="post" name="formParents" id="formParents">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Gestion des parents</label>
                </div>
                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="inputNom">Nom (*)</label>
                        <input type="text" class="form-control" id="nom" name="nom"  required>
                    </div>
                    <div class="form-group col-md-6">
                        <label for="inputPrenom">Prénom (*)</label>
                        <input type="text" class="form-control" id="prenom" name="prenom"  required>
                    </div>
                </div>
                <div class="form-group">
                        <label for="inputLogin">Identifiant (*) <b>(unique)</b></label>
                        <input type="text" class="form-control" id="login" name="login"  required>
                </div>
                <div class="form-group">
                        <label for="inputPassword">Mot de passe (*)</label>
                        <input type="password" class="form-control" id="password" name="password" required autocomplete>
                </div>
                <div class="form-group">
                    <label for="inputAddress">Addresse postale (*)</label>
                    <input type="text" class="form-control" id="adresse" name="adresse" required>
                </div>

                <div class="form-row">
                    <div class="form-group col-md-6">
                        <label for="inputEmail">Email <b>(unique)</b></label>
                        <input type="email" class="form-control" id="email" name="email">
                    </div>
                    <div class="form-group col-md-6">
                        <label for="inputTel">Téléphone (*)</label>
                        <input type="tel" class="form-control" id="tel" name="tel" required>
                    </div>
                </div>

                <div class="form-group">
                        <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter un parent" style="background-color: #189d8c;border: none;"/>
                </div>

                <input type="hidden" id="id" name="id" value="idParent"/>
                

            </form>


            <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="reset();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

					<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>
					
                    {% for flashMessage in app.session.flashbag.get('Exception') %}
                        <br><h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                    {% endfor %}
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th>Parent</th>
                    <th>Identifiant</th>
                    <th width="15%">Mot de passe</th>
                    <th>Téléphone</th>
                    <th>Email</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>

                <tbody>
                {% for key in allParents %}
                    <tr>
                        <td style="background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.idParent}};document.getElementById('idParentDelete').setAttribute('value',idSuppression); $('#exampleModalCenter').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td>{{ key.prenomParent|capitalize }} {{ key.nomParent|capitalize }}</td>
                        <td>{{ key.loginParent }}</td>
                        <td>{{ key.passwordParent }}</td>
                        <td>{{ key.telParent }}</td>
                        <td>{{ key.emailParent }}</td>
                        <td style="background-color: #FFFFFF"><a href="#" id="btnModifier" onclick="modifier('{{ key.idParent }}','{{ key.nomParent }}','{{ key.prenomParent }}','{{ key.loginParent }}','{{ key.passwordParent }}','{{ key.adresseParent }}','{{ key.telParent }}','{{ key.emailParent }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="exampleModalCenter" tabindex="-1" role="dialog" aria-labelledby="exampleModalCenterTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteParent/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer un parent</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="text-align:left;">
                                Attention, vous êtes sur le point de supprimer ce parent.<br><br>
                                Les élèves et toutes les données liées à ce parent seront perdues.
                            </div>
                            <div class="modal-footer">
                                <input type="hidden" id="idParentDelete" name="idParentDelete" />
              
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider" style="background-color: red;border-color: red;">Je continu à ma responsabilité</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau)-->
<SCRIPT>
    function modifier(id, nom, prenom,login,password,adresse,tel,email)
    {
        document.getElementById("nom").value = nom;
        document.getElementById("prenom").value = prenom;
        document.getElementById("login").value = login;
        document.getElementById("password").value = password;
        document.getElementById("adresse").value = adresse;
        document.getElementById("tel").value = tel;
        document.getElementById("email").value = email;
        document.getElementById("id").value = id;
        document.getElementById("btnAjouter").value = 'Modifier un parent';
        //console.log("avant modification");
        var formulaire = document.getElementById('formParents');
        formulaire.setAttribute("action", "../updateParent/");
        //console.log("after modification");
    }
</SCRIPT>

<!-- Clique sur le bouton Reset(dans le formulaire)-->
<SCRIPT>
    function reset()
    {

        document.getElementById("nom").value = '';
        document.getElementById("prenom").value = '';
        document.getElementById("login").value = '';
        document.getElementById("password").value = '';
        document.getElementById("adresse").value = '';
        document.getElementById("tel").value = '';
        document.getElementById("email").value = '';
        //console.log("avant reset");
        document.getElementById("btnAjouter").value = 'Ajouter un parent';
        var formulaire = document.getElementById('formParents');
        formulaire.setAttribute("action", "../addParent/");
        //console.log("after reset");
    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale-->
<SCRIPT type="text/javascript">
    $('#exampleModalCenter').on('shown.bs.modal', function () {
        
        $('#myInput').trigger('focus');
        idSuppression=0;

    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
<SCRIPT type="text/javascript">
    $(document).ready(function() {
        $('#my_table').DataTable({
            "fixedColumns": true,
            "autoWidth": true,
            "scrollX": true,
            "scrollY": true,
            "language": {
                "sProcessing": "Traitement en cours ...",
                "sLengthMenu": "Afficher _MENU_ lignes",
                "sZeroRecords": "Aucun résultat trouvé",
                "sEmptyTable": "Aucune donnée disponible",
                "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
                "sInfoEmpty": "Aucune ligne affichée",
                "sInfoFiltered": "(Filtrer un maximum de _MAX_)",
                "sInfoPostFix": "",
                "sSearch": "Chercher :",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Chargement...",
                "oPaginate": {
                    "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
                },
                "oAria": {
                    "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
                }

            }
        });
    } );
</SCRIPT>

{%  include 'PronoteBundle:Admin:footer.html.twig' %}