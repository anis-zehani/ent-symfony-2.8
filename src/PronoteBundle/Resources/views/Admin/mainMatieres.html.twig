{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >
    
    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification Matiere-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addMatiere/" method="post" name="formMatieres" id="formMatieres">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Gestion des matières</label>
                </div>
                <div class="form-group">
                    <label for="nomMatiere"><b>Nom de la matière (*)</b></label>
                    <input type="text" class="form-control" id="nomMatiere" name="nomMatiere" required>
                </div>
                

                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter une matière" style="background-color: #189d8c;border: none;"/>
                </div>

                <input type="hidden" id="idMatiere" name="idMatiere" value="idMatiere"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetMatiere();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>
				
                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <br><h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th>Nom Matière</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>

                <tbody>
                {% for key in allMatieres %}
                    <tr>
                        <td style="text-align:center;background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.idMatiere}}; document.getElementById('idMatiereDelete').setAttribute('value',idSuppression); $('#ModaleMatiere').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td>{{ key.nomMatiere|capitalize }}</td>
                        <td style="text-align:center;background-color: #FFFFFF"><a href="#" id="btnModifier" onclick="modifierMatiere('{{ key.idMatiere }}','{{ key.nomMatiere }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleMatiere" tabindex="-1" role="dialog" aria-labelledby="exampleModaleMatiereTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteMatiere/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer une matière</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="text-align:left;">
                                Attention, vous êtes sur le point de supprimer cette matière. Les données suivantes qui lui sont liées vont être supprimées :<br><br>
                                -Séances associées dans les emploi du temps.<br>
                                -Notes données aux élèves dans cette matière.<br>
                                -Devoirs à faire donnés aux élèves dans cette matière.<br>
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idMatiereDelete" name="idMatiereDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider" style="background-color: red;border-color: red;">Je continu à ma responsabilité</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Matiere)-->
<SCRIPT>
    function modifierMatiere(idMatiere, nomMatiere)
    {
        document.getElementById("idMatiere").value = idMatiere;
        document.getElementById("nomMatiere").value = nomMatiere;

        document.getElementById("btnAjouter").value = 'Modifier une matière';
        var formulaire = document.getElementById('formMatieres');
        formulaire.setAttribute("action", "../updateMatiere/");

    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Matiere)-->
<SCRIPT>
    function resetMatiere()
    {

        document.getElementById("nomMatiere").value = '';

        document.getElementById("btnAjouter").value = 'Ajouter une matière';
        var formulaire = document.getElementById('formMatieres');
        formulaire.setAttribute("action", "../addMatiere/");

    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale sur Matiere-->
<SCRIPT type="text/javascript">
    $('#ModaleMatiere').on('shown.bs.modal', function () {
        
        $('#myInput').trigger('focus');
        idSuppression=0;
        
    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
<SCRIPT type="text/javascript">
    $(document).ready(function() {
        $('#my_table').DataTable({
            "fixedColumns": true,
            "autoWidth": true,
            "scrollX": true,
            "scrollY": true,
            "language": {
                "sProcessing": "Traitement en cours ...",
                "sLengthMenu": "Afficher _MENU_ lignes",
                "sZeroRecords": "Aucun résultat trouvé",
                "sEmptyTable": "Aucune donnée disponible",
                "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
                "sInfoEmpty": "Aucune ligne affichée",
                "sInfoFiltered": "(Filtrer un maximum de _MAX_)",
                "sInfoPostFix": "",
                "sSearch": "Chercher :",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Chargement...",
                "oPaginate": {
                    "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
                },
                "oAria": {
                    "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
                }

            }
        });
    } );
</SCRIPT>

{%  include 'PronoteBundle:Admin:footer.html.twig' %}