{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >

    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification ActiviteScolaire-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addActiviteScolaire/" method="post" name="formActiviteScolaires" id="formActiviteScolaires">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Activités scolaires</label>
                </div>

                <div class="form-group">
                    <label for="inputClasseActiviteScolaire"><b>Classe concernée (*)</b></label>

                    <select id="classeActiviteScolaire" name="classeActiviteScolaire" style="border-radius: 10px;width: 100%" required>
                        <option value="">Vous devez choisir une classe</option>
                        {% for key in allClasses %}
                            <option value="{{ key.idClasse }}">{{ key.nomClasse|capitalize }}</option>
                        {% endfor %}
                    </select>
                </div>                

                <div class="form-group">
                        <label for="inputDescriptionActiviteScolaire"><b>Description de l'activité (*)</b></label>
                        <textarea class="form-control" rows="5" id="descriptionActiviteScolaire" name="descriptionActiviteScolaire" required></textarea>
                </div>
                
                <div class="form-group">
                    <label for="inputDateActiviteScolaire"><b>Date de l'activité (*)</b></label>
                    <input type="date" class="form-control" id="dateActiviteScolaire" name="dateActiviteScolaire" required>
                </div>

                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter une activité scolaire" style="background-color: #189d8c;border: none;"/>
                </div>

                <input type="hidden" id="idActiviteScolaire" name="idActiviteScolaire" value="idActiviteScolaire"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetActiviteScolaire();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>

                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <br><h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th>Description</th>
                    <th>Date de l'activité</th>
                    <th>Classe</th>
                    <th>Responsable</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allActiviteScolaires %}
                    <tr>
                        <td style="text-align:center;background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.idActiviteScolaire}}; document.getElementById('idActiviteScolaireDelete').setAttribute('value',idSuppression); $('#ModaleActiviteScolaire').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td>{{ key.descriptionActiviteScolaire|capitalize }}</td>
                        <td>{{ key.dateActiviteScolaire }}</td>
                        <td>{{ key.nomclasseActiviteScolaire|capitalize }}</td>
                        <td>{{ key.nomProfesseur|capitalize }}</td>
                        <td style="text-align:center;background-color: #FFFFFF"><a href="#" id="btnModifier" onclick="modifierActiviteScolaire('{{ key.idActiviteScolaire }}','{{ key.descriptionActiviteScolaire |replace({"'": "\\'",'\r\n': '\\r\\n', '\n': '\\n', '\r': '\\r'})}}','{{ key.dateActiviteScolaire |date("Y-m-d")}}','{{ key.classeActiviteScolaire }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleActiviteScolaire" tabindex="-1" role="dialog" aria-labelledby="exampleModaleActiviteScolaireTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteActiviteScolaire/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer une activité scolaire</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="text-align:left;">
                                Attention, vous êtes sur le point de supprimer cette activité scolaire.
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idActiviteScolaireDelete" name="idActiviteScolaireDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Valider</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Élève)-->
<SCRIPT>
    function modifierActiviteScolaire(idActiviteScolaire, descriptionActiviteScolaire, dateActiviteScolaire, classeActiviteScolaire)
    {
        document.getElementById("idActiviteScolaire").value = idActiviteScolaire;
        document.getElementById("descriptionActiviteScolaire").value = descriptionActiviteScolaire;
        document.getElementById("dateActiviteScolaire").value = dateActiviteScolaire;
        document.getElementById("classeActiviteScolaire").value = classeActiviteScolaire;

        document.getElementById("btnAjouter").value = 'Modifier une activité scolaire';
        var formulaire = document.getElementById('formActiviteScolaires');
        formulaire.setAttribute("action", "../updateActiviteScolaire/");
    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Élève)-->
<SCRIPT>
    function resetActiviteScolaire()
    {

        document.getElementById("descriptionActiviteScolaire").value = '';
        document.getElementById("dateActiviteScolaire").value = '';
        document.getElementById("classeActiviteScolaire").value = '';

        document.getElementById("btnAjouter").value = 'Ajouter une activité scolaire';
        var formulaire = document.getElementById('formActiviteScolaires');
        
        formulaire.setAttribute("action", "../addActiviteScolaire/");

    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale sur Élève-->
<SCRIPT type="text/javascript">
    $('#ModaleActiviteScolaire').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');
        idSuppression=0;
    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
