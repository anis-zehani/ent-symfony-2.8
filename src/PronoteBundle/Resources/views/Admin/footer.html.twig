<!-- SESSION TIMEOUT 
https://www.jqueryscript.net/other/Session-Timeout-Alert-Plugin-With-jQuery-userTimeout.html
-->
<script>
    $(document).ready(function(){
        $(document).userTimeout({
            logouturl: '{{app.request.basePath}}/exit/',   
            modalTitle: '',
            modalBody: 'Votre Session va expirer dans 60 secondes',
            modalLogOffBtn: 'Quitter',
            modalStayLoggedBtn: 'Je comprend',
            timer: true, 
            force: 60000,    //1 minute
        	session: 1800000  //30 minutes
        });
    });
</script>



