{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >

    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification Salle-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="../addSalle/" method="post" name="formSalles" id="formSalles">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Gestion des salles</label>
                </div>
                <div class="form-group">
                    <label for="nomSalle"><b>Salle (*)</b></label>
                    <input type="text" class="form-control" id="nomSalle" name="nomSalle" required>
                </div>

                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" value="Ajouter une salle" style="background-color: #189d8c;border: none;"/>
                </div>

                <input type="hidden" id="idSalle" name="idSalle" value="idSalle"/>

            </form>


            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetSalle();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>

                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <br><h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}
            </div>
        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th width="10%">Supprimer</th>
                    <th>Nom de la salle</th>
                    <th width="10%">Modifier</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allSalles %}
                    <tr>
                        <td style="text-align:center;background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.idSalle}}; document.getElementById('idSalleDelete').setAttribute('value',idSuppression); $('#ModaleSalle').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        <td>{{ key.nomSalle|capitalize }}</td>
                        <td style="text-align:center;background-color: #FFFFFF"><a href="#" id="btnModifier" onclick="modifierSalle('{{ key.idSalle }}','{{ key.nomSalle }}');"><img src="{{ asset('./bootstrap/img/update.jpg') }}" width="20" height="20" ></a></td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="form-row">
            <!--------------------------- Feêtre POP-UP la Modale ------------------------------------------------>
            <div class="modal fade" id="ModaleSalle" tabindex="-1" role="dialog" aria-labelledby="exampleModaleSalleTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteSalle/" method="post" name="formModale" id="formModale">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Supprimer une salle</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="text-align:left;">
                                Attention, vous êtes sur le point de supprimer cette salle.
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idSalleDelete" name="idSalleDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Valider</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Clique sur l'icône Modifier (dans le tableau Salle)-->
<SCRIPT>
    function modifierSalle(idSalle, nomSalle)
    {
        document.getElementById("idSalle").value = idSalle;
        document.getElementById("nomSalle").value = nomSalle;

        document.getElementById("btnAjouter").value = 'Modifier une salle';
        var formulaire = document.getElementById('formSalles');
        formulaire.setAttribute("action", "../updateSalle/");

    }
</SCRIPT>
<!-- Clique sur le bouton Reset(dans le formulaire Salle)-->
<SCRIPT>
    function resetSalle()
    {
        document.getElementById("nomSalle").value = '';

        document.getElementById("btnAjouter").value = 'Ajouter une salle';
        var formulaire = document.getElementById('formSalles');
        formulaire.setAttribute("action", "../addSalle/");
    }
</SCRIPT>

<!-- Code qui s'exécute quand j'ouvre la Modale sur Salle-->
<SCRIPT type="text/javascript">
    $('#ModaleSalle').on('shown.bs.modal', function () {
        $('#myInput').trigger('focus');
        idSuppression=0;
    })
</SCRIPT>

<!-- Configuration de la DATATABLE-->
<SCRIPT type="text/javascript">
    $(document).ready(function() {
        $('#my_table').DataTable({
            "fixedColumns": true,
            "autoWidth": true,
            "scrollX": true,
            "scrollY": true,
            "language": {
                "sProcessing": "Traitement en cours ...",
                "sLengthMenu": "Afficher _MENU_ lignes",
                "sZeroRecords": "Aucun résultat trouvé",
                "sEmptyTable": "Aucune donnée disponible",
                "sInfo": "Lignes _START_ à _END_ sur _TOTAL_",
                "sInfoEmpty": "Aucune ligne affichée",
                "sInfoFiltered": "(Filtrer un maximum de _MAX_)",
                "sInfoPostFix": "",
                "sSearch": "Chercher :",
                "sUrl": "",
                "sInfoThousands": ",",
                "sLoadingRecords": "Chargement...",
                "oPaginate": {
                    "sFirst": "Premier", "sLast": "Dernier", "sNext": "Suivant", "sPrevious": "Précédent"
                },
                "oAria": {
                    "sSortAscending": ": Trier par ordre croissant", "sSortDescending": ": Trier par ordre décroissant"
                }

            }
        });
    } );
</SCRIPT>

{%  include 'PronoteBundle:Admin:footer.html.twig' %}