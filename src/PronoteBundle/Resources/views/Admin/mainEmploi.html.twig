{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid" style="padding-top: 10%;background-color: #ffffff; height:88%;overflow-y: scroll ;" >
   
    <div class="row align-items-start">

        <!-- Formulaire Ajout / Modification Emploi Du Temps-->
        <div class="col-sm-3" style="text-align: left;">
            <form action="" method="post" name="formEmploiDuTemps" id="formEmploiDuTemps">
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Ajouter un emploi du temps</label>
                </div>

                <div class="form-group">
                    <label for="inputDesignation">Désignation de l'emploi (*)</label>
                    <input type="texte" class="form-control" id="designation" name="designation" required >
                </div>

                <div class="form-group">
                    <label for="nameScreen" style="color: #189d8c;font-size: 14px;font-weight: 400;">Ci-bas la liste des Classes qui ne possèdent pas encore un Emploi du Temps sur le système.</label>
                </div>

                <div class="form-group">
                    <label for="inputClasseEmploiDuTemps">Veuillez choisir une classe (*)</label>

                    <select id="classeEmploiDuTemps" name="classeEmploiDuTemps" style="border-radius: 10px;width: 100%" required>
                        
                        {% for key in allClasses %}
                            <option value="{{ key.idClasse }}">{{ key.nomClasse|capitalize }}</option>
                        {% endfor %}
                        <option value="NULL">Aucune Classe</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="nameScreen" style="color: #189d8c;font-size: 14px;font-weight: 400;">Ci-bas la liste de toutes les Salles de l'école, chaque Emploi du Temps a droit à une seule Salle.</label>
                </div>

                <div class="form-group">
                    <label for="inputSalleEmploiDuTemps">Veuillez choisir une salle (*)</label>

                    <select id="salleEmploiDuTemps" name="salleEmploiDuTemps" style="border-radius: 10px;width: 100%" required>
                        
                        {% for key in allSalles %}
                            <option value="{{ key.idSalle }}">{{ key.nomSalle|capitalize }}</option>
                        {% endfor %}
                        <option value="NULL">Aucune Salle</option>
                    </select>
                </div>

                <div class="form-group">
                    <button type="button" class="btn btn-primary btn-sm btn-block"  id="btnAjouter" onclick="verifierChampsEtOuvrirModale();" style="background-color: #189d8c;border: none;"/>Ajouter un emploi du temps</button>
                </div>
                <input type="hidden" id="idEmploiDuTemps" name="idEmploiDuTemps" value="idEmploiDuTemps"/>

            </form>

            <div class="form-group">
                <input type="submit" class="btn btn-primary btn-sm btn-block"  onclick="resetEmploiDuTemps();" value="Tout réinitialiser" style="background-color: #ed2b34;border: none;"/>

				<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>
				
                {% for flashMessage in app.session.flashbag.get('Exception') %}
                    <h6 style="color: #e3352c;font-weight: 600;" id="Exception">{{ flashMessage }}</h6>
                {% endfor %}
            </div>


        </div>

        <div class="col-sm-9" style="text-align: left;">

            <table id="my_table" class="table table-striped table-bordered" cellspacing="0" width="100%" style="font-size:13px;overflow-x: scroll ;overflow-y: scroll ;">
                <thead>
                <tr>
                    <th>ID</th>
                    <th>Désignation Emploi</th>
                    <th>Classe</th>
                    <th>Salle</th>
                    <th width="10%">Modifier</th>
                    <th width="10%">Supprimer</th>
                </tr>
                </thead>
                <tbody>
                {% for key in allEmploisDuTemps %}
                    <tr>
                        <td>{{ key.idEmploiDuTemps }}</td>
                        <td>{{ key.designationEmploiDuTemps|capitalize }}</td>
                        <td>{{ key.nomClasseEmploiDuTemps|capitalize }}</td>
                        <td>{{ key.nomSalleEmploiDuTemps|capitalize }}</td>

                        <td style="text-align:center;background-color: #FFFFFF">
                        
                            <form action="{{app.request.basePath}}/admin/showOneEmploiDuTemps/" method="post">
                            	<input src="{{ asset('./bootstrap/img/update.jpg') }}" type="image" width="20" height="20">

                                <input type="hidden" id="idClasse" name="idClasse" value={{key.classeEmploiDuTemps}} />
                                <input type="hidden" id="idEmploiDuTemps" name="idEmploiDuTemps" value={{key.idEmploiDuTemps}} />
                            </form>
                        
                        </td>

                        <td style="text-align:center;background-color: #FFFFFF">
                            <a href="#" onclick="idSuppression={{key.idEmploiDuTemps}}; document.getElementById('idEmploiDuTempsDelete').setAttribute('value',idSuppression); $('#ModaleSuppressionEmploiDuTemps').modal();"><img src="{{ asset('./bootstrap/img/delete.jpg') }}" width="20" height="20" ></a>
                        </td>
                        </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>

      
        <div class="form-row">
            <!------------------------------------------ POP-UP Supprimer EMPLOI DU TEMPS------------------------------------------------>
            <div class="modal fade bd-example-modal-lg" id="ModaleSuppressionEmploiDuTemps" tabindex="-1" role="dialog" aria-labelledby="exampleModaleEmploiDuTempsTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered" role="document">
                    <form action="../deleteEmploiDuTemps/" method="post" name="JumboModaleSuppression" id="JumboModaleSuppression">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle" style="color: red;">Supprimer un emploi du temps </h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>
                            <div class="modal-body" style="text-align:left;">
                                Attention, si vous supprimez cet emploi du temps, vous n'aurez plus la possibilité de le récupérer.<br><br>
                                L'application web pourra être menacée.
                            </div>
                            <div class="modal-footer">
                            	<input type="hidden" id="idEmploiDuTempsDelete" name="idEmploiDuTempsDelete" />
                            	
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider" style="background-color: red;border-color: red;">Je continu à ma responsabilité</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>


        <div class="form-row">
            <!-------------------------------------------- POP-UP Ajouter EMPLOI DU TEMPS ------------------------------------------------>
            <div class="modal fade bd-example-modal-lg" id="ModaleAjoutEmploiDuTemps" tabindex="-1" role="dialog" aria-labelledby="exampleJumboModaleEmploiDuTempsTitle" aria-hidden="true">
                <div class="modal-dialog modal-lg" role="document">
                    <form action="../addEmploiDuTemps/" method="post" name="JumboModaleAjout" id="JumboModaleAjout">
                        <div class="modal-content">
                            <div class="modal-header">
                                <h5 class="modal-title" id="exampleModalLongTitle">Ajouter un emploi du temps</h5>
                                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                    <span aria-hidden="true">&times;</span>
                                </button>
                            </div>

                            <div class="modal-body">
                                {% include 'PronoteBundle:Admin:ajouterEmploiPopModale.html.twig' %}
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-dismiss="modal">Annuler</button>
                                <button type="submit" class="btn btn-primary" id="btnValider">Enregistrer le nouvel Emploi</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>

    </div>
</div>




<!-- Clique sur le bouton Reset(dans le formulaire Emploi Du Temps)-->
<SCRIPT>
    function resetEmploiDuTemps()
    {
        document.getElementById("classeEmploiDuTemps").value = '';
        document.getElementById("btnAjouter").value = 'Ajouter un emploi du temps';

        var formulaire = document.getElementById('formEmploiDuTemps');
        formulaire.setAttribute("action", "../addEmploiDuTemps/");
    }
</SCRIPT>


<!-- Code qui s'exécute quand j'ouvre la Modale sur Emploi Du Temps (Suppression)-->
<SCRIPT type="text/javascript">

    $('#ModaleSuppressionEmploiDuTemps').on('shown.bs.modal', function () {
        $('#myInput1').trigger('focus');
        $('#myInput1').modal('handleUpdate');
        idSuppression=0;
    })
</SCRIPT>



<!-- Clique sur le bouton Ajouter Emploi Du Temps : vérifier que les champs sont pas vides -->
<SCRIPT>
    function verifierChampsEtOuvrirModale()
    {

        var idClasse = document.getElementById("classeEmploiDuTemps").value;
        var idSalle = document.getElementById("salleEmploiDuTemps").value;
        var designation = document.getElementById("designation").value;

        document.getElementById("idClasseAjout").value = idClasse;
        document.getElementById("idSalleAjout").value = idSalle;
        document.getElementById("idDesignation").value = designation;

        console.log(designation);

        if(idClasse && idSalle && designation)
        {
            $('#ModaleAjoutEmploiDuTemps').modal();
            return;
        }
        window.alert("ATTENTION : Vous devez remplir tous les champs"); //return;

    }
</SCRIPT>


<!-- Code qui s'exécute quand j'ouvre la Modale sur Emploi Du Temps (Modification)-->
<SCRIPT type="text/javascript">
    $('#ModaleModificationEmploiDuTemps').on('shown.bs.modal', function () {
        $('#myInput3').trigger('focus');
        $('#myInput3').modal('handleUpdate');


        document.getElementById("idEmploi").value = idEmploi;

        $.ajax({
            url : '../showOneEmploiDuTemps/'+idClasse,
            type : 'GET',
            dataType : 'html',
            success : function(data, statut){

                var allEmplois = $.parseJSON(data);
                console.log(allEmplois);
              
            },

            error : function(resultat, statut, erreur){
                console.log(statut);
                console.log(erreur);
                console.log(resultat);
            }
        });

        var formulaire = document.getElementById('JumboModaleModification');
        formulaire.setAttribute("action", "../updateEmploiDuTemps/");

        idEmploi=0;

    })
</SCRIPT>


