{%  include 'PronoteBundle:Admin:header.html.twig' %}

<div class="container-fluid " style="padding-top: 10%; height:88%; background-color: #ffffff; overflow-y: scroll ; text-align: left" >
    
    <form action="{{app.request.basePath}}/admin/updateEmploiDuTemps/" method="post">
        <div class="row align-items-start">

            <div class="col-sm-3" >
                <div class="form-group">
                    <label for="nameScreen" style="color: #ed2b34;font-size: 18px;font-weight: 600;">Modifier un emploi  du temps</label>
                </div>

                <div class="form-group">
                    <label for="inputDesignation">Désignation de l'emploi (*)</label>
                    <input type="texte" class="form-control" id="idDesignation" name="idDesignation" value="{{ allEmplois.designation }}" placeholder="Désignation Emploi" required >
                </div>

                <div class="form-group">
                    <label for="inputClasseEmploiDuTemps">Veuillez choisir une classe (*)</label><br>

                    <select id="classeEmploiDuTemps" name="classeEmploiDuTemps" style="border-radius: 10px;width: 100%" required>

                        {% if classeAndSalle is defined %}
                            <option value="{{ classeAndSalle.idClasse }}">{{ classeAndSalle.nomClasse|capitalize }}</option>
                        {% endif %}
						
                        {% for key in allClasses %}
                            <option value="{{ key.idClasse }}">{{ key.nomClasse|capitalize }}</option>
                        {% endfor %}
                        <option value="0">Aucune Classe</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="inputSalleEmploiDuTemps">Veuillez choisir une salle (*)</label><br>

                    <select id="salleEmploiDuTemps" name="salleEmploiDuTemps" style="border-radius: 10px;width: 100%" required>


                        {% if classeAndSalle is defined %}
                            <option value="{{ classeAndSalle.idSalle }}">{{ classeAndSalle.nomSalle|capitalize }}</option>
                        {% endif %}
						
                        {% for key in allSalles %}
                        	{% if classeAndSalle is defined and key.idSalle != classeAndSalle.idSalle %}
                           		 <option value="{{ key.idSalle }}">{{ key.nomSalle|capitalize }}</option>
                            {% endif %}
                        {% endfor %}
                        <option value="0">Aucune Salle</option>
                    </select>
                </div>
                <div class="form-group">
                    <input type="submit" class="btn btn-primary btn-sm btn-block"  value="Sauvegarder" style="background-color: #189d8c;border: none;"/>

					<br><label for="champsobligatoire"><b>(*) Champs obligatoire</b></label>

                    {% for flashMessage in app.session.flashbag.get('Exception') %}
                        <h6 style="color: #e3352c;" id="Exception">{{ flashMessage }}</h6>
                    {% endfor %}
                </div>
                {% if idEmploi is defined %}
                    <input type="hidden" id="idEmploiDuTemps" name="idEmploiDuTemps" value="{{ idEmploi }}"/>
                {% endif %}


            </div>
