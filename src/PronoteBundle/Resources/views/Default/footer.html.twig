<SCRIPT>
	//Désactive une notification pour un élève
    function deactivateNotification(idNotification, lienNotification, idParent, idEleve)
    {

        /*console.log("idNotification = "+idNotification);
        console.log("lienNotification = "+lienNotification);
        console.log("idParent = "+idParent);
        console.log("idEleve = "+idEleve);*/

    	var xmlhttp;
        xmlhttp = new XMLHttpRequest();
        xmlhttp.onreadystatechange = function()
        	{
            if (xmlhttp.readyState == 4 && xmlhttp.status == 200){
                
                url="{{app.request.basePath}}/" + lienNotification+"/";
            	
            	$.redirect(url,
                {
            		idParent: idParent,
					idEleve : idEleve
                });

            }
        }

		xmlhttp.open('POST', '{{app.request.basePath}}/deactivateNotification/', true);
        xmlhttp.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
        xmlhttp.send('idNotification='+idNotification);
        

    }

</SCRIPT>

<SCRIPT>
	//Désactive une notification pour une classe
    function deactivateNotificationClasse(idNotificationClasse, lienNotification, idParent, idClasse, idEleve)
    {
    	/*console.log("idNotificationClasse = "+idNotificationClasse);
        console.log("lienNotification = "+lienNotification);
        console.log("idParent = "+idParent);
        console.log("idClasse = "+idClasse);
        console.log("idEleve = "+idEleve);*/

    	var xmlhttp;
        xmlhttp = new XMLHttpRequest();
        xmlhttp.onreadystatechange = function()
        	{
            if (xmlhttp.readyState == 4 && xmlhttp.status == 200){
                
                url="{{app.request.basePath}}/" + lienNotification;
                
                if (lienNotification.length > 0)
                    {
            			$.redirect(url,
            	                {
            						idParent: idParent,
            						idClasse : idClasse,
            						idEleve : idEleve
            	                });
                	}
                else
                    {
                		location.reload();
                    }
            	
            }
        }

        xmlhttp.open('POST', '{{app.request.basePath}}/deactivateNotificationClasse/', true);
        xmlhttp.setRequestHeader('Content-type', 'application/x-www-form-urlencoded');
        xmlhttp.send('idNotificationClasse='+idNotificationClasse);

    }

</SCRIPT>

