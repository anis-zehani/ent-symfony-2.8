<div class="table-responsive">
    <table class="table table-bordered table-hover" style="font-size: 13px;vertical-align: middle;">
        <thead>

        <div class="alert alert-secondary blink_me" role="alert" style="padding: .4rem .2rem;margin-bottom:2px;background-color: #45a6bf;border: none; color: #FFFFFF;">
			<form action="{{app.request.basePath}}/travailafaire/" method="post">
                  <input type="hidden" id="idParent" name="idParent" value="{{pageData1.idParent }}"/>
                  {% if pageData4 |length > 0 %}
         			  	  <input type="hidden" id="idEleve" name="idEleve" value="{{ pageData4[0].idEleve }}"/>
        		  {% endif %}
                  {% if pageData2 |length > 0 %}
         			  	  <input type="hidden" id="idClasse" name="idClasse" value="{{ pageData2[0].idClasse }}"/>
        		  {% endif %}
                  <input type="submit" value="TRAVAIL À FAIRE" style="color:white;background-color:#45a6bf;border:0;cursor: pointer;">
            </form> 
		</div>
        
        </thead>
        <tbody>
        
            {% for key in pageData5 %}
                {% if key.messagePasDeDevoirs is defined %}
                
    			<tr>
                    <td style="background-color: #fff;padding: .15rem; vertical-align: middle;color: green;font-weight:600;text-align: justify;">{{ key.messagePasDeDevoirs }}</td>
                </tr>
				
    		    {% else %}
                    <tr>
                        <td scope="row" style="width:40%;color: #000000;vertical-align:middle;font-weight:600;">{{ key.nomMatiere |capitalize}}<br>{{ key.donnePour }}</td>
                        <td style="padding: .15rem; vertical-align: middle;background-color: #FFFFFF" title="Donné le : {{ key.donneLe }}">{{ key.detailsDevoir |capitalize}}</td>
                    </tr>
                {% endif %} 

            {% endfor %}

        </tbody>
    </table>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-hover" style="font-size: 13px;vertical-align: middle;">
        <thead>
       		<div class="alert alert-secondary" role="alert" style="padding: .4rem .2rem;margin-bottom:2px;background-color: #45a6bf;border: none; color: #FFFFFF;">RESSOURCES PÉDAGOGIQUES</div>
        </thead>
        <tbody>
        {% for key in pageData9 %}
            <tr>
                <td style="padding: .15rem; vertical-align: middle;background-color: #FFFFFF;font-weight:bold;text-align: justify;">{{ key.descriptionTelechargement |capitalize}}</td>
                {% if key.pathTelechargement|length > 0 %}
                    <td style="padding: .15rem; vertical-align: middle;background-color: #FFFFFF;"><a href="{{app.request.basePath}}/{{ key.pathTelechargement }}" style="color:#775ca1">Télécharger</a></td>
                {% endif %}

            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>